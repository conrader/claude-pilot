{
  "description": "Report Codex lifecycle events to claude-pilot-hookd and let claude-pilot control Stop continuations.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/claude_pilot_codex_hook.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/claude_pilot_codex_hook.py\"",
            "timeout": 20,
            "statusMessage": "Checking claude-pilot goal"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/claude_pilot_codex_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
